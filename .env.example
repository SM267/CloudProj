# Application
CLOUDPROJ_ENVIRONMENT=development
CLOUDPROJ_DEFAULT_LLM_PROVIDER=stub
CLOUDPROJ_DEFAULT_CLOUD_PROVIDER=docker
CLOUDPROJ_LOG_LEVEL=INFO

# LLM transport
CLOUDPROJ_LLM_TIMEOUT_SECONDS=30
CLOUDPROJ_LLM_MAX_RETRIES=2

# OpenAI (set DEFAULT_LLM_PROVIDER=openai to use it)
# CLOUDPROJ_OPENAI_API_KEY=
CLOUDPROJ_OPENAI_MODEL=gpt-4o-mini
CLOUDPROJ_OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (set DEFAULT_LLM_PROVIDER=gemini to use it)
# CLOUDPROJ_GEMINI_API_KEY=
CLOUDPROJ_GEMINI_MODEL=gemini-2.5-flash
CLOUDPROJ_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama (set DEFAULT_LLM_PROVIDER=ollama to use it)
CLOUDPROJ_OLLAMA_BASE_URL=http://localhost:11434
CLOUDPROJ_OLLAMA_MODEL=llama3.2
